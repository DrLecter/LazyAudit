/* ==========================================================================
   LazyAudit — Solo Formas, Estructura y Proporciones
   Los colores los maneja Textual de forma nativa (soporta modo claro/oscuro con 'D')
   ========================================================================== */

/* Proporción de dos columnas en cada solapa */
TabPane > Horizontal {
    height: 1fr;
}

TabPane > Horizontal > Vertical:first-child {
    width: 40%;
    border-right: vkey $primary;
    padding: 0 1;
}

TabPane > Horizontal > Vertical:last-child {
    width: 60%;
    padding: 0 2;
}

/* Tablas y Listas ocupando todo el alto disponible */
DataTable {
    height: 1fr;
}

ListView {
    height: 1fr;
}

ListItem {
    padding: 0 1;
}

/* Tarjetas métricas (Solapa Proyectos) */
#count_hosts, #count_findings, #count_variables, #count_commands {
    width: 1fr;
    height: 4;
    border: round $primary;
    content-align: center middle;
    text-align: center;
    margin: 0 1 1 0;
}

/* Grid de detalles de proyecto */
#grid_detalle {
    grid-size: 2;
    grid-columns: 16 1fr;
    margin-top: 1;
}

/* Consola de Workflows */
#wf_console {
    height: 1fr;
    border: round $primary;
    margin-top: 1;
}

/* Modales centrados en pantalla */
ModalScreen {
    align: center middle;
}

/* Tarjeta flotante del modal */
ModalScreen > Vertical {
    width: 60;
    height: auto;
    border: round $primary;
    background: $surface;
    padding: 1 2;
}

#model_title, #model_task, #model_finding, #model_host, #model_key, #model_var {
    text-align: center;
    margin-bottom: 1;
    text-style: bold;
}

/* Inputs y Selects */
Input {
    margin-bottom: 1;
    border: round $primary-lighten-2;
}

Select {
    margin-bottom: 1;
    border: round $primary-lighten-2;
}

/* Botones dentro del modal */
#modal_btns {
    align: right middle;
    height: 3;
    margin-top: 1;
}

Button {
    min-width: 12;
    margin-left: 1;
}
